memvisualisasikan Spell mereka."
visible_characters = 0
visible_ratio = 0.0

[node name="Label3" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
text = "Setiap kali kamu mau menggunakan Magic, kamu harus 
memainkan minigame terlebih dahulu."
visible_characters = 0
visible_ratio = 0.0

[node name="Label4" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
text = "Ada 4 panah abu-abu yang diam dan satu panah ungu 
akan berjalan keatas. Ketika panah ungu sampai di atas,"

[node name="Label5" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
text = "Tekan tombol panah kanan pada keyboard jika panah yang 
bergerak mengarah kanan dan begitu untuk semua arah."
visible_characters = 0
visible_ratio = 0.0

[node name="Label6" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
text = "Jika kamu berhasil menekan panah dengan tepat di panah 
abu-abu, Bar yang di atas akan terisi. "

[node name="Label7" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
text = "Bar akan berkurang jika kamu salah menekan panah atau 
panahnya melewati panah abu-abu."

[node name="Label8" type="Label" parent="."]
offset_left = 32.0
offset_top = 184.0
offset_right = 780.0
offset_bottom = 224.0
scale = Vector2(0.5, 0.5)
theme = ExtResource("2_3niol")
