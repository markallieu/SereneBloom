Join kaine 1
Join Aeiri 1
if {haveTalkedToAeiri} == "false":
	kaine: Halo, namaku Kaine, Junior Magus.
	Aeiri: Ooh Magus? Namaku Aeiri, Alchemist desa ini.
	kaine: Aeiri yang membuat Rejuvenation Potion itu!?
	Aeiri: Ahahaha, benar.
	kaine: Aku gak nyangka, pembuat Rejuvenation Potion yang bisa meningkatkan kapasitas Mana secara besar dan tanpa efek samping ada disini.
	Aeiri: Sama-sama.
	Aeiri: Akademi mana tempat kamu kuliah? Apakah Akademi mu menggunakannya?
	kaine: Aku dari Aetherius Tower, setiap ada Luminous Duel para peserta disediakan Rejuvenation Potion sebagai .
	Aeiri: Aetherius Tower? Ada Magus yang bertalenta banget disini.
	kaine: Ehehe… makasih.
	VAR {haveTalkedToAeiri} = "true"
	[signal arg="WarmGreeting"]
if {haveTalkedToReva} == "true":
	kaine: Oh ya, Reva bilang kamu ada Orchid. Apakah aku boleh minta 2?
	Aeiri: Ini Orchidnya.
	kaine: Terimakasih, Aeiri!
	Aeiri: Sama-sama.
	[signal arg="Orchid"]
	VAR {BuildingAStatue.Orchid} = "true"
elif {haveTalkedToAeiri} == "true":
	if {haveTalkedToReva} == "false":
		Aeiri: Selamat siang!
	if {BuildingAStatue.Orchid} == "true":
		Aeiri: Selamat siang!
